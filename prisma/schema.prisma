// Prisma schema for the SG Home Services portfolio + blog site.
// Single admin worker, public portfolio/blog browsing, WhatsApp contact only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The single admin user (the home-services worker). Managed by NextAuth.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts Post[]
}

model Post {
  id             String       @id @default(cuid())
  title          String
  slug           String       @unique
  excerpt        String?
  content        String? // markdown body
  /// "portfolio" | "blog"
  type           String       @default("portfolio")
  category       String?
  tags           String? // comma-separated
  featured       Boolean      @default(false)
  published      Boolean      @default(true)
  coverImage     String?
  views          Int          @default(0)
  whatsappClicks Int          @default(0)
  authorId       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  author        User?         @relation(fields: [authorId], references: [id])
  images        PostImage[]
  analytics     AnalyticsEvent[]

  @@index([type, published, featured])
  @@index([slug])
}

model PostImage {
  id        String  @id @default(cuid())
  postId    String
  url       String
  /// "gallery" | "before" | "after"
  kind      String  @default("gallery")
  position  Int     @default(0)
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String? // e.g. "HDB Owner, Bedok"
  rating    Int      @default(5) // 1..5
  content   String
  avatar    String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Lightweight event-sink for analytics: page views, whatsapp clicks, dwell time.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  eventType String // "page_view" | "post_view" | "whatsapp_click" | "dwell"
  postId    String?
  session   String?
  duration  Int? // seconds, for dwell events
  path      String?
  createdAt DateTime @default(now())

  post Post? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
}

/// Single-row table holding every piece of tweakable site text/config.
/// The worker edits this from the admin "Site Settings" tab — no code changes needed.
/// Fields are stored as JSON strings for flexibility (services array, hero stats, etc.).
model SiteSettings {
  id              String   @id @default("singleton")
  brand           String   @default("Ahmad HomeWorks")
  tagline         String   @default("Singapore's Trusted Handyman")
  workerName      String   @default("Ahmad Rahman")
  phone           String   @default("+65 9123 4567")
  whatsapp        String   @default("6591234567")
  email           String   @default("hello@ahmadhomeworks.sg")
  location        String   @default("Singapore · Islandwide")
  yearsExperience Int      @default(12)
  jobsCompleted   Int      @default(540)
  happyClients    Int      @default(320)
  rating          Float    @default(4.9)
  heroHeadline    String   @default("Your home, expertly handled.")
  heroSubtext     String   @default("Singapore's trusted handyman for plumbing, painting, renovation, electrical and interior works.")
  aboutTitle      String   @default("Built on trust. Delivered with care.")
  aboutBody       String   @default("We are a Singapore-based home-services company with over a decade of hands-on experience across HDB flats, condominiums and landed homes. Our commitment is simple: show up when we say, do the job properly, and stand behind our work.")
  servicesJson    String   @default("[]") // JSON array of {key,label,icon,desc}
  updatedAt       DateTime @updatedAt
}
